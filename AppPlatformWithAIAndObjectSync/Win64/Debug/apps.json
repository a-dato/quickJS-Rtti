  {
    "id": "6e8b01e5-07fd-4373-8f05-7649b89ee06d",
    "name": "Projects & Trello Tasks (copy)",
    "description": "Read-only list of projects and their assigned Trello tasks, kept live with AppPlatform.",
    "html": "<!--LYNX_APP_META_V1:-->\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n* { box-sizing: border-box; }\nbody { margin: 0; padding: 8px; font: 12px/1.35 \"Segoe UI\", Arial, sans-serif; color: #1f2a3d; background: #f4f6fa; height: 100vh; display: flex; flex-direction: column; gap: 6px; }\nh1 { margin: 0; font-size: 14px; font-weight: 650; }\n.toolbar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }\ninput { font: inherit; padding: 4px 6px; border: 1px solid #cfd8e6; border-radius: 4px; width: 220px; }\nlabel { font-size: 11px; color: #51627e; }\n.table-wrap { flex: 1; overflow: auto; min-height: 0; border: 1px solid #d6deea; background: white; }\ntable { width: 100%; border-collapse: collapse; table-layout: fixed; }\nth, td { padding: 5px 7px; text-align: left; border-bottom: 1px solid #e5eaf1; overflow-wrap: anywhere; vertical-align: top; }\nth { position: sticky; top: 0; background: #edf1f7; font-size: 11px; }\nth:first-child { width: 35%; }\n.muted { color: #778294; }\n#status { min-height: 16px; color: #51627e; }\n#status.err { color: #b52d2d; }\n</style>\n</head>\n<body>\n<h1>Projects & Trello tasks</h1>\n<div class=\"toolbar\"><label for=\"search\">Filter</label><input id=\"search\" type=\"search\" placeholder=\"Project or task\" disabled><span id=\"count\" class=\"muted\"></span></div>\n<div class=\"table-wrap\"><table><thead><tr><th>Project</th><th>Assigned Trello task</th></tr></thead><tbody id=\"rows\"></tbody></table></div>\n<div id=\"status\" role=\"status\">Loading projects...</div>\n<script>\nconst searchEl = document.getElementById('search');\nconst rowsEl = document.getElementById('rows');\nconst statusEl = document.getElementById('status');\nconst countEl = document.getElementById('count');\nlet projects = [];\nlet loading = true;\nlet ready = false;\n\nfunction updateControls() {\n  searchEl.disabled = loading || !ready;\n}\n\nfunction render() {\n  const query = searchEl.value.trim().toLowerCase();\n  let shown = 0;\n  const rows = [];\n  for (const project of projects) {\n    const name = String(project.Description.value ?? '');\n    const task = String(project.TrelloTask.value ?? '');\n    if (query && !(name + ' ' + task).toLowerCase().includes(query)) {\n      continue;\n    }\n    const row = document.createElement('tr');\n    const nameCell = document.createElement('td');\n    const taskCell = document.createElement('td');\n    nameCell.textContent = name;\n    taskCell.textContent = task || 'No task assigned';\n    if (!task) {\n      taskCell.className = 'muted';\n    }\n    row.append(nameCell, taskCell);\n    rows.push(row);\n    shown++;\n  }\n  if (!shown) {\n    const row = document.createElement('tr');\n    const cell = document.createElement('td');\n    cell.colSpan = 2;\n    cell.className = 'muted';\n    cell.textContent = projects.length ? 'No matching projects.' : 'No projects.';\n    row.append(cell);\n    rows.push(row);\n  }\n  rowsEl.replaceChildren(...rows);\n  countEl.textContent = shown + ' of ' + projects.length;\n}\n\nasync function init() {\n  updateControls();\n  try {\n    projects = await host.open('projects');\n    projects.onChanged(render);\n    ready = true;\n    render();\n    statusEl.textContent = 'Read-only · Updates live from AppPlatform';\n  } catch (err) {\n    statusEl.textContent = err.message || String(err);\n    statusEl.className = 'err';\n  } finally {\n    loading = false;\n    updateControls();\n  }\n}\n\nsearchEl.addEventListener('input', render);\ninit();\n</script>\n<script_host>\npage.expose('projects', {\n  Description: 'read',\n  TrelloTask: 'read'\n}, app.Storage['Projects']);\n</script_host>\n</body>\n</html>"
