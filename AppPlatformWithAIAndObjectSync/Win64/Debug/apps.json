  {
    "id": "8073460d-dbc0-42f1-8362-69d9904abf59",
    "name": "Project Editor",
    "description": "Browse projects in a left-hand list and edit only the selected project's description. Changes stay synchronized with AppPlatform.",
    "html": "<!--LYNX_APP_META_V1:-->\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n* { box-sizing: border-box; }\nbody { margin: 0; padding: 8px; font: 12px/1.35 \"Segoe UI\", Arial, sans-serif; color: #1f2a3d; background: #f4f6fa; height: 100vh; display: flex; flex-direction: column; }\nh1 { margin: 0 0 6px; font-size: 14px; font-weight: 650; }\n.layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); flex: 1; min-height: 0; border: 1px solid #cfd8e6; background: white; }\n.sidebar { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid #cfd8e6; }\n.caption { padding: 6px 8px; font-size: 11px; color: #51627e; border-bottom: 1px solid #e2e7ef; }\n#projects { overflow: auto; flex: 1; padding: 3px; }\n.project { display: block; text-align: left; width: 100%; padding: 5px 7px; margin: 0 0 2px; border: 1px solid transparent; border-radius: 3px; background: transparent; color: inherit; font: inherit; overflow-wrap: anywhere; cursor: pointer; }\n.project:hover { background: #f0f4fa; }\n.project.selected { background: #e7efff; border-color: #b8cef5; color: #164681; }\n.project:focus-visible { outline: 2px solid #407ac4; }\n.detail { padding: 8px; overflow: auto; min-width: 0; }\nlabel { display: block; font-size: 11px; color: #51627e; margin-bottom: 3px; }\ntextarea { width: 100%; min-height: 110px; resize: vertical; font: inherit; padding: 5px 6px; border: 1px solid #cfd8e6; border-radius: 4px; }\ntextarea:read-only { background: #eef1f6; color: #6b7385; }\n.note { margin-top: 5px; color: #65738a; font-size: 11px; }\n#identity { color: #65738a; margin-bottom: 8px; font-size: 11px; overflow-wrap: anywhere; }\n#status { margin-top: 6px; min-height: 17px; color: #4b5d78; }\n#status.err { color: #b52e2e; }\n.empty { padding: 8px; color: #65738a; }\n@media (max-width: 460px) { .layout { grid-template-columns: 145px minmax(0, 1fr); } }\n</style>\n</head>\n<body>\n<h1>Project editor</h1>\n<div class=\"layout\">\n  <aside class=\"sidebar\" aria-label=\"Project list\">\n    <div class=\"caption\" id=\"count\">Projects</div>\n    <div id=\"projects\" aria-label=\"Projects\"></div>\n  </aside>\n  <section class=\"detail\" aria-label=\"Selected project\">\n    <div id=\"identity\">No project selected</div>\n    <label for=\"description\">Description</label>\n    <textarea id=\"description\" readonly disabled></textarea>\n    <div class=\"note\">Changes save when you leave the description field. Only the description is editable.</div>\n  </section>\n</div>\n<div id=\"status\" role=\"status\" aria-live=\"polite\">Loading projects...</div>\n<script>\nconst listEl = document.getElementById('projects');\nconst descriptionEl = document.getElementById('description');\nconst statusEl = document.getElementById('status');\nconst identityEl = document.getElementById('identity');\nconst countEl = document.getElementById('count');\nlet projects = null;\nlet selectedId = null;\nlet busy = true;\n\nfunction selectedProject() {\n  return projects ? projects.find(project => String(project.ID.value) === selectedId) : null;\n}\n\nfunction setStatus(text, error = false) {\n  statusEl.textContent = text;\n  statusEl.className = error ? 'err' : '';\n}\n\nfunction updateControls() {\n  const selected = selectedProject();\n  descriptionEl.disabled = busy || !selected;\n  descriptionEl.readOnly = !selected || !selected.Description.editable;\n  listEl.querySelectorAll('button').forEach(button => {\n    button.disabled = busy;\n  });\n}\n\nfunction render() {\n  const selected = selectedProject();\n  if (!selected && projects && projects.length) {\n    selectedId = String(projects[0].ID.value);\n  }\n  listEl.replaceChildren();\n  if (projects) {\n    for (const project of projects) {\n      const id = String(project.ID.value);\n      const button = document.createElement('button');\n      button.type = 'button';\n      button.className = 'project' + (id === selectedId ? ' selected' : '');\n      button.textContent = project.Description.value || '(Untitled project)';\n      button.setAttribute('aria-pressed', String(id === selectedId));\n      button.addEventListener('click', () => {\n        selectedId = id;\n        render();\n        setStatus('');\n      });\n      listEl.append(button);\n    }\n    countEl.textContent = 'Projects (' + projects.length + ')';\n    if (!projects.length) {\n      const empty = document.createElement('div');\n      empty.className = 'empty';\n      empty.textContent = 'No projects available.';\n      listEl.append(empty);\n    }\n  }\n  const current = selectedProject();\n  identityEl.textContent = current ? 'Project ID: ' + String(current.ID.value) : 'No project selected';\n  descriptionEl.value = current ? (current.Description.value ?? '') : '';\n  updateControls();\n}\n\nasync function init() {\n  try {\n    projects = await host.open('projects');\n    projects.onChanged(render);\n    const context = await host.run('initialSelection', null, { label: 'Loading project selection' });\n    selectedId = context.id;\n    render();\n    setStatus(projects.length ? '' : 'No projects available.');\n  } catch (err) {\n    setStatus(err.message || String(err), true);\n  } finally {\n    busy = false;\n    updateControls();\n  }\n}\n\ndescriptionEl.addEventListener('change', async () => {\n  const project = selectedProject();\n  if (!project || busy) return;\n  const value = descriptionEl.value;\n  busy = true;\n  updateControls();\n  setStatus('Saving description...');\n  try {\n    await project.Description.edit(value);\n    setStatus('Description saved.');\n  } catch (err) {\n    setStatus(err.message || String(err), true);\n  } finally {\n    busy = false;\n    render();\n  }\n});\n\nupdateControls();\ninit();\n</script>\n<script_host>\npage.expose('projects', { ID: 'read', Description: 'edit' }, app.Storage['Projects']);\n\nconst initialProject = page.param('project');\n\nactions.initialSelection = () => {\n  return { id: initialProject ? String(initialProject.ID) : null };\n};\n</script_host>\n</body>\n</html>"
  }
