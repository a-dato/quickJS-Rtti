[
  {
    "id": "e8bc1e69-8fb3-4e5a-b2dc-86fae4d5c39d",
    "name": "Trello Tasks",
    "description": "Preview Trello cards and import them into TrelloTask using Token Vault credentials.",
    "html": "<!--LYNX_APP_META_V1:-->\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n* { box-sizing: border-box; }\nbody { margin: 0; padding: 8px; font: 12px/1.35 'Segoe UI', Arial, sans-serif; background: #f4f6fa; color: #1f2a3d; }\nh1 { font-size: 14px; margin: 0 0 6px; }\n.row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }\nselect { flex: 1; min-width: 150px; }\nbutton, select { font: inherit; padding: 4px 8px; border: 1px solid #cfd8e6; border-radius: 4px; }\nbutton { background: #2f6fed; color: white; cursor: pointer; }\nbutton:disabled { opacity: .5; cursor: default; }\n.note { font-size: 11px; color: #59677c; margin: 6px 0; }\n#setup { padding: 6px; border: 1px solid #d6a35e; margin-bottom: 6px; }\n#results { height: 260px; overflow: auto; background: white; border: 1px solid #dfe4ee; margin-top: 6px; }\ntable { width: 100%; border-collapse: collapse; }\nth, td { text-align: left; padding: 4px 6px; border-bottom: 1px solid #e8edf3; }\nth { position: sticky; top: 0; background: #eef2f7; }\n#status { margin-top: 6px; min-height: 18px; }\n.err { color: #b83232; }\n</style>\n</head>\n<body>\n<h1>Trello Tasks</h1>\n<div id=\"setup\">Checking connection...</div>\n<div class=\"row\">\n<select id=\"boards\" aria-label=\"Trello board\"></select>\n<button id=\"retry\">Retry connection</button>\n<button id=\"preview\">Pull preview</button>\n<button id=\"apply\">Import tasks</button>\n</div>\n<div class=\"note\">Includes archived cards. Matches by Card ID; no project assignment. Imports last until AppPlatform restarts or the type reloads.</div>\n<div id=\"summary\">Select a board and pull a preview.</div>\n<div id=\"results\"><table><thead><tr><th>Action</th><th>Card</th><th>Archived</th></tr></thead><tbody id=\"rows\"></tbody></table></div>\n<div id=\"status\" role=\"status\"></div>\n<script>\nconst boardsEl = document.getElementById('boards');\nconst retry = document.getElementById('retry');\nconst preview = document.getElementById('preview');\nconst apply = document.getElementById('apply');\nconst setup = document.getElementById('setup');\nconst statusEl = document.getElementById('status');\nconst summary = document.getElementById('summary');\nconst rows = document.getElementById('rows');\nlet busy = false;\nlet connected = false;\nlet plan = null;\nfunction setStatus(text, error) {\n  statusEl.textContent = text;\n  statusEl.className = error ? 'err' : '';\n}\nfunction updateControls() {\n  retry.disabled = busy;\n  boardsEl.disabled = busy || !connected;\n  preview.disabled = busy || !connected || !boardsEl.value;\n  apply.disabled = busy || !connected || !plan || !plan.changes || plan.blocked;\n}\nasync function runHost(action, args, label) {\n  busy = true;\n  updateControls();\n  setStatus(label + '...', false);\n  try {\n    return await window.host.run(action, args, { label });\n  } catch (err) {\n    setStatus(err.name === 'AbortError' ? 'Stopped.' : err.message || String(err), err.name !== 'AbortError');\n    throw err;\n  } finally {\n    busy = false;\n    updateControls();\n  }\n}\nfunction clearPlan() {\n  plan = null;\n  rows.replaceChildren();\n  summary.textContent = 'Select a board and pull a preview.';\n  updateControls();\n}\nasync function connect() {\n  connected = false;\n  clearPlan();\n  setup.hidden = false;\n  setup.textContent = 'Checking connection...';\n  try {\n    const boards = await runHost('connect', null, 'Checking Trello connection');\n    boardsEl.replaceChildren();\n    for (const board of boards) {\n      const option = document.createElement('option');\n      option.value = board.id;\n      option.textContent = board.name;\n      boardsEl.appendChild(option);\n    }\n    connected = true;\n    setup.hidden = true;\n    setStatus(boards.length + ' boards available.', false);\n  } catch (err) {\n    setup.textContent = err.name === 'AbortError' ? 'Connection check stopped. Retry when ready.' : err.message || String(err);\n  }\n  updateControls();\n}\npreview.addEventListener('click', async () => {\n  clearPlan();\n  try {\n    plan = await runHost('preview', { board: boardsEl.value }, 'Loading Trello cards');\n    for (const item of plan.items) {\n      const tr = document.createElement('tr');\n      for (const text of [item.operation, item.card.Name, item.card.Closed ? 'Yes' : 'No']) {\n        const td = document.createElement('td');\n        td.textContent = text;\n        tr.appendChild(td);\n      }\n      rows.appendChild(tr);\n    }\n    summary.textContent = plan.items.length + ' cards: ' + plan.added + ' create, ' + plan.updated + ' update, ' + plan.skipped + ' skip, ' + plan.blocked + ' ambiguous (blocked).';\n    setStatus('Preview ready. Import tasks applies only this preview.', false);\n  } catch (err) {\n    setStatus(err.name === 'AbortError' ? 'Stopped.' : err.message || String(err), err.name !== 'AbortError');\n  }\n  updateControls();\n});\napply.addEventListener('click', async () => {\n  try {\n    const result = await runHost('import', { board: boardsEl.value, snapshot: plan.snapshot }, 'Importing Trello tasks');\n    clearPlan();\n    setStatus('Imported: ' + result.added + ' created, ' + result.updated + ' updated.', false);\n  } catch (err) {\n    clearPlan();\n    setStatus(err.name === 'AbortError' ? 'Stopped. Pull a new preview to check partial results.' : err.message || String(err), err.name !== 'AbortError');\n  }\n  updateControls();\n});\nboardsEl.addEventListener('change', clearPlan);\nretry.addEventListener('click', connect);\nupdateControls();\nconnect();\n</script>\n<script_host>\nfunction decode(body) {\n  if (typeof body === 'string') {\n    const text = String(body).trim();\n    if (text.startsWith('<')) {\n      throw new Error('Incompatible response: Trello returned HTML. Check service access.');\n    }\n    try {\n      return JSON.parse(text);\n    } catch (err) {\n      throw new Error('Incompatible response: expected Trello JSON.');\n    }\n  }\n  return body;\n}\nasync function read(path) {\n  if (!tokens['TrelloKey'] || !tokens['TrelloCredentials']) {\n    throw new Error('Missing credential: update TrelloKey and TrelloCredentials in Settings > App Tokens, then Retry connection.');\n  }\n  const url = 'https://api.trello.com/1/' + path + (path.indexOf('?') >= 0 ? '&' : '?') + 'key=' + encodeURIComponent(String(tokens['TrelloKey'])) + '&token=' + encodeURIComponent(String(tokens['TrelloCredentials']));\n  let response;\n  try {\n    response = await httpGet(url);\n  } catch (err) {\n    const message = String(err.message || '');\n    if (/401|400|invalid token|invalid key/i.test(message)) {\n      throw new Error('Rejected credential: check TrelloCredentials and TrelloKey in Settings > App Tokens; Retry connection.');\n    }\n    if (/403/.test(message)) {\n      throw new Error('Insufficient rights: TrelloCredentials cannot read this resource. Retry connection or choose another board.');\n    }\n    throw new Error('Network/service error contacting Trello. Retry connection.');\n  }\n  if (Number(response.status) < 200 || Number(response.status) >= 300) {\n    throw new Error('Trello rejected the request (HTTP ' + Number(response.status) + '). Check TrelloCredentials and TrelloKey, then Retry connection.');\n  }\n  const data = decode(response.body);\n  if (!Array.isArray(data)) {\n    throw new Error('Incompatible response: expected a Trello collection.');\n  }\n  return data;\n}\nasync function boards() {\n  const data = await read('members/me/boards');\n  return data.map(b => {\n    if (!b.id || b.name == null) {\n      throw new Error('Incompatible board response.');\n    }\n    return { id: String(b.id), name: String(b.name) };\n  });\n}\nasync function buildPlan(board) {\n  const accessible = await boards();\n  if (!accessible.some(b => b.id === board)) {\n    throw new Error('Board is not available. Retry connection.');\n  }\n  const data = await read('boards/' + encodeURIComponent(board) + '/cards?filter=all&fields=name,desc,url,idBoard,closed');\n  const storage = JSON.parse(types.Objects('TrelloTask'));\n  if (!storage.ok || !Array.isArray(storage.objects)) {\n    throw new Error('Could not read TrelloTask storage.');\n  }\n  const byId = {};\n  for (let i = 0; i < storage.objects.length; i++) {\n    const obj = storage.objects[i];\n    const id = String(obj.CardID || '');\n    if (!byId[id]) {\n      byId[id] = [];\n    }\n    byId[id].push(obj);\n    progress(i + 1, storage.objects.length, 'Comparing stored tasks');\n  }\n  const result = { items: [], added: 0, updated: 0, skipped: 0, blocked: 0, changes: 0 };\n  for (let i = 0; i < data.length; i++) {\n    const c = data[i];\n    if (!c.id || c.name == null || c.desc == null || !c.url || String(c.idBoard) !== board || typeof c.closed !== 'boolean') {\n      throw new Error('Incompatible Trello card fields.');\n    }\n    const card = { Name: String(c.name), CardID: String(c.id), Description: String(c.desc), URL: String(c.url), BoardID: board, Closed: Boolean(c.closed) };\n    const matches = byId[card.CardID] || [];\n    let operation;\n    if (matches.length > 1) {\n      operation = 'Ambiguous';\n      result.blocked++;\n    } else if (!matches.length) {\n      operation = 'Create';\n      result.added++;\n    } else if (Object.keys(card).every(key => String(card[key]) === String(matches[0][key]))) {\n      operation = 'Skip';\n      result.skipped++;\n    } else {\n      operation = 'Update';\n      result.updated++;\n    }\n    result.items.push({ operation, card });\n    progress(i + 1, data.length, 'Preparing ' + card.Name);\n  }\n  result.changes = result.added + result.updated;\n  result.snapshot = JSON.stringify(result.items);\n  return result;\n}\nif (action === 'connect') {\n  return await boards();\n}\nif (action === 'preview' || action === 'import') {\n  const board = String(args && args.board || '');\n  if (!/^[a-f0-9]{24}$/.test(board)) {\n    throw new Error('Select a valid board.');\n  }\n  const plan = await buildPlan(board);\n  if (action === 'preview') {\n    return plan;\n  }\n  if (plan.blocked) {\n    throw new Error('Duplicate stored Card IDs are ambiguous. Resolve duplicates before importing.');\n  }\n  if (String(args.snapshot || '') !== plan.snapshot) {\n    throw new Error('Cards or stored tasks changed. Pull a new preview before importing.');\n  }\n  const changes = plan.items.filter(item => item.operation === 'Create' || item.operation === 'Update').map(item => item.card);\n  if (!changes.length) {\n    return { added: 0, updated: 0 };\n  }\n  const result = JSON.parse(types.Import('TrelloTask', JSON.stringify(changes), 'CardID'));\n  if (!result.ok) {\n    throw new Error('TrelloTask import failed. Pull a new preview before retrying.');\n  }\n  if (result.warnings && result.warnings.length) {\n    throw new Error('Import completed with warnings: ' + JSON.stringify(result.warnings));\n  }\n  return { added: Number(result.added), updated: Number(result.updated) };\n}\nthrow new Error('Unknown action: ' + action);\n</script_host>\n</body>\n</html>"
